# The C++ of mod/: LLVM's style with four spaces and 120 columns. The sources are in this format (clang-format 19):
#   clang-format -i mod/src/main.cpp mod/src/core.h mod/src/*.inc mod/src/vtidx.c mod/dinput/dinput.cpp
# Not mod/src/eye_tl_vs.h: the shader compiler writes it.
# (Visual Studio's Build Tools bring clang-format: VC\Tools\Llvm\bin.)
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 120
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: true
AllowShortFunctionsOnASingleLine: All
AllowShortBlocksOnASingleLine: Empty
# the Windows and OpenXR headers come in an order that matters
SortIncludes: Never
# a comment after a member tells what it is: kept in one column within a block
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0
