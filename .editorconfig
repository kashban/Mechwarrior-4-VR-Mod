# What an editor needs to know to leave the files as the checks want them.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cpp,h,inc,c,hlsl}]
max_line_length = 120

[*.py]
max_line_length = 120

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{cmd,bat,ps1,psd1}]
end_of_line = crlf

[*.md]
max_line_length = 120
trim_trailing_whitespace = false
