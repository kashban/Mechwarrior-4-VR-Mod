; MW4VR - settings. Copy this file into the game's folder as mw4vr.ini.
; Most of it is read again every 2 seconds while the game runs; "read at the start" is said where not.
; The keys that change values in a battle write them back into this file.

[vr]
; 1 = start OpenXR (the active 32-bit runtime) and play in the headset; 0 = the mod does nothing
enabled=1
; 1 = head tracking: the game's camera follows the headset (Ctrl+Home recentres); 0 = a fixed stereo screen
tracking=1
; 1 = both eyes are drawn in every frame (no trails on moving things, no ghosting; costs GPU time);
; 0 = the eyes alternate frame by frame
double_draw=1
; 0 = the game draws the world twice, once for each eye; 1 = it draws the world for the left eye only, and
; each of its draws is made a second time for the right eye by the mod: much faster where the processor is
; the limit, a little slower where the graphics card is (docs/PERFORMANCE.md); 2 = the mod takes whichever
; of the two is faster where the battle is - it begins with the mod's way (on missions measured to be faster
; the game's way: with that) and changes when the other is clearly faster. Only with double_draw=1.
; (8, 9: diagnosis - a file mw4vr_replay.txt, see mod/src/replay.cpp.) Read at the start
replay_right=2
; 1 = nothing is drawn beyond the map's fog (what lies there has the fog's colour alone; mw4hook's far_scale
; draws four kilometres far, most of it unseen - up to twice the pictures a second); 0 = all of it
fog_cull=1
; 1 = a battle's picture stays dark until the new terrain, grass and trees are there (two or three seconds),
; then it comes up; 0 = shown from the first frame, the old terrain first. Read at the start
load_hold=1
; the game renders at this height whatever the size of its window (the width follows the window's shape);
; 0 = at the window's size. More pixels = sharper and slower. Read at the start
render_height=2600
; the rendered field of view: the headset's, times this (smaller = sharper)
fov_scale=1.0
; 1 = the water mirrors the scene in both eyes (drawn a second time for the right eye); 0 = in the left eye only
water_both_eyes=1
; 1 = in a battle the cursor is kept inside the game's window (no loss of keyboard input at full stick)
mouse_capture=1

; --- sizes and the seat (the values for a cockpit nobody has set yet; see "cockpit profiles" below) ---
; head movement in the game times this: larger = the whole world looks smaller (Ctrl+Shift+Ins / Del)
world_scale=0.505
; the cockpit's size against the world (Ctrl+Ins / Ctrl+Del): larger = the cockpit looks smaller
cockpit_scale=2.647
; the cockpit is what the game draws nearer than this (game metres)
cockpit_range_m=8.0
; the seat moved forward / up, game metres (Ctrl+Up / Down forward / back, Ctrl+Right / Left up / down)
seat_forward_m=-0.60
seat_up_m=0.00
; cockpit profiles (mw4vr_mechs.ini): the mech is recognised at the start of a battle and gets its own cockpit
; scale, seat and HUD places. Ctrl+F10 = this cockpit fits as it is (it becomes a measure for the others).
; mech_auto_fit: cockpits not set by hand are fitted from those that are. mech_profiles=0: the values above for all
mech_profiles=1
mech_auto_fit=1

; --- the HUD ---
; 1 = the HUD as layers of its own, fixed to the mech; 0 = left in the picture
hud_layer=1
; distance of the far middle (cross-hair, target marks) in metres; Ctrl+PgUp farther, Ctrl+PgDn nearer, Ctrl+End far
hud_distance_m=200.00
; where the HUD picture's top strip ends and its bottom strip begins (0..1 of the height), and the sides of the far
; middle (0..1 of the width)
hud_top=0.12
hud_bottom=0.77
hud_left=0.25
hud_right=0.72
; the game's HUD runs past the right edge of a square picture (weapon list, damage display): the HUD picture is
; this much wider than the game's (1 = not). Read at the start
hud_extra_width=1.02
; 1 = without a cockpit mesh of our own the HUD's parts (radar, target, damage, lance list, weapons, top strip) are
; panes of their own before the pilot, in a row below the view ahead (the compass above it). In a battle: look somewhere and press
; Ctrl+Alt+1..6 to put a part there; Ctrl+Alt+Shift+1..6 chooses one, then Ctrl+Alt+Shift + arrows move it,
; PgUp / PgDn size it, Ins / Del set it farther / nearer, 0 hides it; Ctrl+Alt+7 puts all back into the row.
; Stored for each mech in mw4vr_mechs.ini as hud_part_<radar|target|damage|lance|weapons|top> = degrees right, up,
; width, metres away; the same keys here are the places for mechs that have none of their own.
; Seen from outside (the third-person view) the parts have places of their own, the same for every mech:
; hud_out_<name>, set with the same keys while outside.
; 0 = the flat frame of hud_parts=0 instead: the picture's edge strips near, at hud_panel_distance_m
hud_parts=1
hud_panel_distance_m=1.5
hud_panel_scale=0.6
; Esc in a battle: the game's menu (the whole HUD picture) as one flat screen straight ahead, at this size
; against the game's view. 0 = off (the menu stays in the HUD's parts)
menu_scale=1.5
hud_panel_x_m=0
hud_panel_y_m=0
; 1 = the near HUD and a MechWarrior 5 cockpit sway with the mech's steps, as the game's own cockpit does;
; hud_sway_gain: how much (1 = as the game's cockpit)
hud_sway=1
hud_sway_gain=1.0
; the torso mark (below the cross-hair) is cut out of the HUD picture (u0 v0 u1 v1) and shown higher by
; hud_twist_shift (negative = up; 0 = left where it is)
hud_twist_rect=0.42 0.585 0.58 0.665
hud_twist_shift=-0.045
; the cross-hair with its range, pitch scale and weapon groups: that part of the HUD picture (u0 v0 u1 v1, about the
; picture's middle) is shown at hud_cross_scale of its size (0.1..1; 1 = as the game draws it), as a layer of its
; own. What is green or yellow there is the cross-hair; a target's mark (red, blue) keeps its size and place. Not
; while the zoom window is open.
hud_cross_rect=0.39 0.415 0.61 0.585
hud_cross_scale=0.25
; zoomed in: the zoom window's size against the game's picture, and the zoomed picture's share of the full view
zoom_window_scale=0.45
zoom_scale=0.9

; --- MechWarrior 5 cockpits: a mesh of our own in place of the game's (mw4vr_cockpits\<name>.mwc - see the README) ---
; mw5_on=1: the cockpits are used where there is one (mw4vr_cockpit_map.ini names one per mech; Ctrl+Alt+F11 in a
; battle chooses another); without cockpit files it changes nothing. Ctrl+F11 switches in a battle.
; mw5_cockpit: the cockpit for mechs nothing else names one for (empty: the game's own cockpit there)
mw5_on=1
mw5_cockpit=
; brightness of its lit displays; its base light (0..1); mw5_linear_output=1 if it looks washed out
mw5_emissive=1.5
mw5_ambient=0.45
; the world's light on the cockpit, read from the picture: bright under a bright sky, dark at night, lighter from
; the sky's side than from the ground's (0: the fixed lamp alone .. 1); the least light it leaves (0..1)
mw5_light=1
mw5_light_floor=0.3
; how much of the world's light reaches faces that look into the cockpit - the panel's front, undersides (0..1)
mw5_light_inside=0.55
; shade in corners and gaps, reckoned when a cockpit is loaded (0: none .. 1)
mw5_shade=1
; the brightest place of the picture - the sun, a fire, a shot - lights the faces turned to it (0: not .. 1)
mw5_sun=1
; the monitors' and lamps' light on what is about them, at night (0: none; 0.5)
mw5_glow=0.5
; gloss on every part (0..1); the sky mirrored on faces seen at a flat angle (0: not)
mw5_gloss=0.1
mw5_reflect=0.5
; painted metal of mod cockpits: the patches, worn paint and gloss (0: plain colours .. 1); how much paint is worn off (0..1)
mw5_paint=1
mw5_paint_wear=0.5
; the mech's own arms and weapons beside and above the cockpit (0: off). Its parts are read once, the first time
; the mech is looked at from outside (V), and kept in mw4vr_arms\<mech>.mwa
arms=1
; how far (m) the arms go forth and back with the mech's steps (0: not)
arms_swing=0.25
; mechs whose arms have no joints and stay put (their names as in mw4vr_arms, with commas)
arms_rigid=urbanmech,urbanmech_iic,rifleman,catapult,catapultk2,jenner2c,locust2c,raven,stalker
; which parts are drawn: a part's middle at least arms_side m to the side and not lower than arms_low m, or at
; least arms_above m over the eye; lower down, to arms_deep of the way to the feet, only a part arms_wide m out
; or long and slim; nothing nearer to the eye than arms_near m. arms_all=1: every part
arms_side=1.2
arms_low=-2.5
arms_deep=0.45
arms_wide=2.4
arms_above=0.8
arms_near=1.3
arms_all=0
mw5_linear_output=1
mw5_reversed_depth=1
; share of the depth range kept for the cockpit alone (0.9 .. 0.98): the ground and the mech's own hull cannot
; cut through it
mw5_depth_front=0.92
; 1 = the cockpit's monitors show parts of the HUD (each cockpit's own file says which; Ctrl+Alt+9 in a battle
; switches one cockpit's monitors off); mw5_glass=1 = what no monitor shows is on the cockpit's glass
mw5_screens=1
mw5_glass=1
mw5_screen_gain=1.0
; dark red on the monitors (an enemy's weapon list) is shown up to this many times brighter; 1 = as it is
mw5_screen_red_boost=6

; --- the help page ---
; Ctrl+F1 in a battle shows the keys as a page in the headset. help_pause=1: the game waits while it is up;
; help_clock=1: the time it was up is taken off the clocks the game reads (0: the game sees one long frame)
help_pause=1
help_clock=1
; help_size: the page's size, per cent (30..96) of the middle of the view
help_size=60

; --- for finding faults ---
; mw4hook_any_build=1: use the parts that reach into mw4hook.dll although it is not the build this was made for
; cam_planes=1: the game culls trees and tiles with the head's view (0 = with the mech's own: things vanish)
cam_planes=1
cam_keep=0
cam_local=0
; the older eye's picture is turned by what the mech turned since (only with double_draw=0)
mech_reproject=1

[debug]
; 0 = the log (mw4vr.log) alone and short; 1 = everything: all log lines, every shader (mw4vr_shaders.txt,
; mw4vr_shaders\), the audit, frame captures (Ctrl+Shift+F11) and the labels of a frame some seconds into a battle
level=0
